# Plantilla del .env del servidor de aplicacion (20.2). El .env real lo escribe scripts/desplegar-staging.sh con los
# secretos del ambiente de GitHub (staging o piloto), con permisos 600; nunca se versiona. Los valores de aqui son
# marcadores: el flujo de la etapa 8 rechaza un secreto de piloto que aparezca en el repositorio (CC-022).
IMAGEN_API=ghcr.io/<dueno>/sce-api@sha256:<digest>
IMAGEN_PORTAL=ghcr.io/<dueno>/sce-portal@sha256:<digest>
DOMINIO=localhost
DATABASE_URL=postgresql://sce_app:<clave>@<ip-de-la-base>:5432/sce?schema=public&sslmode=require&sslcert=/certs/db.crt&sslaccept=strict
JWT_SECRET=<64 caracteres hexadecimales>
CONTRASENA_SEMILLA=<32 caracteres hexadecimales>
SEMILLA=1
