{
  "uid": "sce",
  "title": "SCE — Tabla 57",
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "sce"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad (24 h, CO-FIA-01)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_success{job=\"salud\"}[24h])"
        }
      ]
    },
    {
      "id": 2,
      "title": "Salud por destino",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"salud\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 por ruta (RNF-REN-001; metas 3 s y 2 s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, ruta) (rate(sce_http_duracion_segundos_bucket{job=\"api\", ruta!~\"/metricas|/salud\"}[5m])))",
          "legendFormat": "{{ruta}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Peticiones por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (estado) (rate(sce_http_duracion_segundos_count{job=\"api\"}[1m]))",
          "legendFormat": "{{estado}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tasa de 5xx (meta < 1 %)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sce_http_duracion_segundos_count{job=\"api\", estado=~\"5..\"}[5m])) / sum(rate(sce_http_duracion_segundos_count{job=\"api\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 6,
      "title": "Errores de negocio por código",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (codigo) (rate(sce_errores_negocio_total[5m])) * 60",
          "legendFormat": "{{codigo}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "CPU del servidor (meta < 80 %)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 8,
      "title": "Memoria por contenedor",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name=~\"sce-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "CPU por contenedor",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"sce-.*\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Conexiones a la base (pool de 20)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends{datname=\"sce\"})",
          "legendFormat": "conexiones"
        }
      ]
    },
    {
      "id": 11,
      "title": "Memoria de la API (fugas, CR-REN-05)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sce_process_resident_memory_bytes",
          "legendFormat": "rss"
        }
      ]
    },
    {
      "id": 12,
      "title": "Retraso del event loop de la API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sce_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
