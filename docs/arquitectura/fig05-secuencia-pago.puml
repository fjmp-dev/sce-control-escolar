@startuml fig05-secuencia-pago
' Figura 5. Diagrama de secuencia UML: pago con control de idempotencia (RF-006).
' Fuente: SCE-MC-001 v2.0, seccion 13.4. Actualizada por CC-020 (pasarela simulada, sin
' Mercado Pago) y CC-011 (fecha_confirmacion). Documenta el control que evita el cargo
' duplicado: riesgo RK-02, defecto #69 corregido en #71.
skinparam shadowing false
autonumber

actor Alumno as AL
participant "Portal" as UI
participant "Gateway de API" as GW
participant "Dominio de pagos" as DPAG
participant "Servicio de bitacora" as BIT
database "PostgreSQL" as DB
participant "Pasarela simulada\n(CC-020)" as PS

AL -> UI : consulta estado de cuenta
UI -> GW : GET /alumnos/actual/cuenta
GW -> DPAG : estadoDeCuenta(matricula)
DPAG -> DB : SELECT cuenta_alumno, movimiento
DB --> DPAG : saldo y movimientos
DPAG --> UI : estado de cuenta

AL -> UI : elige pagar un importe
UI -> GW : POST /pagos
GW -> DPAG : iniciarPago(matricula, importe)
DPAG -> DB : INSERT pago (estado = pendiente,\nreferencia y clave_idempotencia UNIQUE)
DPAG --> UI : pago pendiente
UI --> AL : pantalla de la pasarela simulada

AL -> PS : aprueba o rechaza
PS -> GW : POST /pagos/{id}/simulacion (resultado)\n(puede llegar mas de una vez)
GW -> DPAG : simular(matricula, id, resultado)

group Transaccion atomica
  DPAG -> DB : SELECT pago FOR UPDATE
  alt pago ajeno o inexistente
    DPAG --> GW : 404
  else resultado = rechazado
    DPAG -> DB : UPDATE pago SET estado = rechazado
    DPAG -> BIT : pago_rechazado (usuario tecnico, R-21)
  else resultado = aprobado
    DPAG -> DB : SELECT cuenta_alumno FOR UPDATE
    alt el pago ya estaba aplicado (aviso duplicado)
      DPAG --> GW : 200, sin efecto
      note right of DPAG
        RK-02: un segundo aviso del mismo
        pago no genera otro movimiento.
      end note
    else el importe ya no cabe en el saldo (#69)
      DPAG -> DB : UPDATE pago SET estado = rechazado
      DPAG -> BIT : pago_rechazado (valor anterior)
      DPAG --> GW : 409 PAGO_NO_APLICABLE, despues del COMMIT
    else primer aviso y cabe en el saldo
      DPAG -> DB : UPDATE pago SET estado = aplicado
      DPAG -> DB : UPDATE pago SET fecha_confirmacion =\nclock_timestamp() (CC-011)
      DPAG -> DB : INSERT movimiento (un solo abono)
      DPAG -> DB : UPDATE cuenta_alumno SET saldo
      DPAG -> BIT : pago_aplicado (usuario tecnico, CC-015)
      BIT -> DB : INSERT bitacora (autor, accion,\nvalor_anterior, fecha)
    end
  end
end

GW --> UI : estado del pago
UI --> AL : pago reflejado y recibo (GET /pagos/{id})

note over DPAG, DB
  RF-006: el pago se refleja una sola vez y sin comprobante en papel.
  CD-DAT-03 concilia saldo, pagos, abonos y corte; CD-DAT-06 mide
  movimiento.fecha - fecha_confirmacion (p95 < 60 s).
end note

@enduml
