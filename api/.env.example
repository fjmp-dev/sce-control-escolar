DATABASE_URL="postgresql://sce_app:sce_dev@localhost:5432/sce?schema=public"
# Al menos 32 caracteres; distinto en cada ambiente (Tabla 38).
JWT_SECRET="cambia-esto-en-cada-ambiente-por-uno-largo"
# Duracion del token, del token de rol privilegiado y de la sesion completa, con renovaciones (Tabla 38, CS-SEG-07).
SESION_MINUTOS=60
SESION_PRIVILEGIADA_MINUTOS=15
SESION_MAXIMA_MINUTOS=480
PORT=3001

# Testcontainers con Colima en macOS (npm test no usa DATABASE_URL: levanta su propio PostgreSQL 16).
# DOCKER_HOST="unix:///Users/<usuario>/.colima/default/docker.sock"
# TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE="/var/run/docker.sock"
