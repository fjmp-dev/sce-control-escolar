# Plantilla del .env del servidor de base (20.2). El real lo escribe scripts/staging.sh en cada corrida, o DevOps en un
# servidor real, con permisos 600; nunca se versiona.
COMPOSE_FILE=compose.yml
POSTGRES_PASSWORD=<32 caracteres hexadecimales; el superusuario solo entra por el socket local>
SCE_APP_PASSWORD=<48 caracteres hexadecimales>
RED_APP=<rango del servidor de aplicacion, p. ej. 172.30.250.16/28>
NOMBRE_DB=<nombre o IP del certificado de la base>
ESCUCHA=<IP de la interfaz privada>
